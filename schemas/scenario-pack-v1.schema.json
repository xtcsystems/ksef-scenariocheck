{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xtcsystems/ksefguard/schemas/scenario-pack-v1.schema.json",
  "title": "KSeF Guard scenario pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "sourceReferences", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "pl"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "pl": { "type": "string", "minLength": 1 }
      }
    },
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "fixture", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["certificate-metadata", "qr-verification-link", "offline24-timeline", "retry-recovery-sequence", "unresolved-status"]
          },
          "fixture": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
