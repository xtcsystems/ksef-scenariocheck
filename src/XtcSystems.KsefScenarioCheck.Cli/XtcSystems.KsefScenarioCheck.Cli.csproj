<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>XtcSystems.KsefScenarioCheck.Cli</AssemblyName>
    <RootNamespace>XtcSystems.KsefScenarioCheck</RootNamespace>
    <Version>0.1.0-alpha.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ksef-scenariocheck</ToolCommandName>
    <PackageId>XtcSystems.KsefScenarioCheck.Tool</PackageId>
    <PackageVersion>0.1.0-alpha.1</PackageVersion>
    <Authors>XtcSystems</Authors>
    <Description>Local deterministic evaluation of synthetic KSeF integration observations.</Description>
    <PackageTags>KSeF;testing;CLI;CI</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/xtcsystems/ksef-scenariocheck</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../XtcSystems.KsefScenarioCheck.Core/XtcSystems.KsefScenarioCheck.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../schemas/*.json"
          Link="schemas/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="tools/net10.0/any/schemas/" />
    <None Include="../../packs/baseline-pl/pack.json"
          Link="packs/baseline-pl/pack.json"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="tools/net10.0/any/packs/baseline-pl/" />
  </ItemGroup>
</Project>
